APP_NAME=embedding-service
APP_HOST=0.0.0.0
APP_PORT=8090
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Active embedding identity (change + restart; consumers reindex on index_key change)
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
# EMBED_DIM=
# EMBED_API_KEY=
# EMBED_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Local HuggingFace (after: pip install -r requirements-local.txt)
# EMBED_PROVIDER=local
# EMBED_MODEL=BAAI/bge-m3
# EMBED_DEVICE=cpu

EMBED_BATCH_MAX=64
EMBED_MAX_CHARS=8000

# Optional
# API_BEARER_TOKEN=
