# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_NAME=embedding-service
APP_HOST=0.0.0.0
APP_PORT=8090
LOG_LEVEL=INFO
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Active embedding identity — change + restart.
# Consumers must full-reindex whenever index_key changes:
#   openai -> openai__text-embedding-3-small__d1536
#   local  -> local__BAAI_bge-m3__d1024
# ---------------------------------------------------------------------------
EMBED_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small
# Leave empty: resolved from the model name (and probed for local models).
# EMBED_DIM=

# --- Option A: OpenAI / OpenAI-compatible API ------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=   # takes priority over OPENAI_API_KEY
# EMBED_BASE_URL=

# --- Option B: local BAAI/bge-m3 — no API key, runs on this machine --------
# 1) set here:   EMBED_PROVIDER=local
#                EMBED_MODEL=BAAI/bge-m3
#                WITH_LOCAL_MODELS=true
# 2) rebuild:    docker compose up -d --build
#    (without Docker: pip install -r requirements-local.txt)
#
# EMBED_PROVIDER=local
# EMBED_MODEL=BAAI/bge-m3

# auto | cpu | cuda | cuda:0 | mps
# auto uses the GPU when torch can see one, and falls back to cpu when it cannot.
EMBED_DEVICE=auto
# L2-normalise vectors (cosine similarity becomes a dot product). Keep on for bge-m3.
EMBED_NORMALIZE=true
# Texts per forward pass. GPU: 32-64. CPU: 4-8.
EMBED_LOCAL_BATCH_SIZE=8
# Ask the model for its real vector width at startup when EMBED_DIM is empty.
EMBED_PROBE_DIM=true
# Only for Hub models that ship custom code.
EMBED_TRUST_REMOTE_CODE=false
# Instruction prefixes. bge-m3 needs none; e5-style models want "query: " / "passage: ".
# EMBED_QUERY_PREFIX=
# EMBED_DOCUMENT_PREFIX=
# Never reach the network for weights (pair with a warm hf_cache volume).
# HF_HUB_OFFLINE=1
# Optional: lifts HuggingFace Hub rate limits and speeds up the first download.
# HF_TOKEN=

# ---------------------------------------------------------------------------
# Docker build — only read by `docker compose build`
# ---------------------------------------------------------------------------
# Install torch + sentence-transformers into the image. Adds ~2-3GB.
WITH_LOCAL_MODELS=false
# CPU wheels, or a CUDA index matching the host driver: cu126 / cu128 / cu130.
# RTX 50xx (Blackwell) needs cu128 or newer.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu130
# Bake weights into the image so the first request is not a 2.2GB download.
# PRELOAD_MODEL=BAAI/bge-m3
# Raise when the first boot has to download a large model.
HEALTHCHECK_START_PERIOD=60s

# ---------------------------------------------------------------------------
# Limits / auth
# ---------------------------------------------------------------------------
EMBED_BATCH_MAX=64
EMBED_MAX_CHARS=8000
# API_BEARER_TOKEN=
